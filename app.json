{
  "expo": {
    "name": "Lu-Ks",
    "slug": "lu-ks",
    "scheme": "luks",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F2F2F7",
    "ios": {
      "bundleIdentifier": "com.jimenez19pro.luks",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Lu-Ks usa la cámara solo cuando tú lo eliges, para tomar fotos de recibos y de garantías.",
        "NSPhotoLibraryUsageDescription": "Lu-Ks usa tus fotos solo cuando tú eliges una, para leer recibos y guardar garantías."
      }
    },
    "android": {
      "package": "com.jimenez19pro.luks",
      "adaptiveIcon": {
        "backgroundImage": "./icon.png",
        "foregroundImage": "./icono-fondo.png",
        "backgroundColor": "#0047D6"
      },
      "permissions": [
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#F2F2F7",
          "dark": {
            "image": "./icon.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#007AFF"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lu-Ks usa tus fotos solo cuando tú eliges una, para leer recibos y guardar garantías.",
          "cameraPermission": "Lu-Ks usa la cámara solo cuando tú lo eliges, para tomar fotos de recibos y de garantías.",
          "microphonePermission": false
        }
      ]
    ],
    "owner": "lu-ks-app",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6974df26-5e12-43c2-b9ed-94661531dc85",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "6974df26-5e12-43c2-b9ed-94661531dc85"
      }
    },
    "description": "Lu-Ks: tus finanzas personales, claras."
  }
}
